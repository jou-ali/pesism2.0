{
  "name": "tournax",
  "private": true,
  "version": "0.1.0",
  "description": "TOURNAX: eFootball tournament website, admin panel and WhatsApp score bot",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tournax/web",
    "api": "cd apps/backend && gradlew.bat bootRun",
    "build": "npm run build -w @tournax/web",
    "bot": "npm run dev -w @tournax/bot",
    "test": "npm test -w @tournax/core",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15"
  }
}
